# Imagen de la API (core + api). En Linux el editable install funciona sin el
# problema de los .pth ocultos de macOS.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY examples ./examples

RUN uv sync --all-packages --frozen

ENV PATH="/app/.venv/bin:$PATH"
WORKDIR /app/packages/api

EXPOSE 8000

# Aplica migraciones y arranca el servidor.
CMD ["sh", "-c", "alembic upgrade head && uvicorn agenteval_api.main:app --host 0.0.0.0 --port 8000"]
