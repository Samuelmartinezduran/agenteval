# Copia este fichero a .env y ajusta los valores.

# Base de datos de la API (Postgres en producción/Docker).
AGENTEVAL_DATABASE_URL=postgresql+psycopg://agenteval:agenteval@localhost:5432/agenteval

# Juez por defecto de la API y la CLI: "heuristic" (sin coste) u "openai".
AGENTEVAL_JUDGE=heuristic

# Necesaria solo si usas el juez "openai".
OPENAI_API_KEY=

# Orígenes permitidos por CORS (dashboard). Lista JSON.
AGENTEVAL_CORS_ORIGINS=["http://localhost:5173"]
